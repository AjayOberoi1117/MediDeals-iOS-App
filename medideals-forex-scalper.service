[Unit]
Description=MediDeals Forex Scalper Bot (MT5 Vantage DEMO)
Documentation=file:///home/medideals/DIGITALOCEAN_DEPLOYMENT.md
After=network-online.target medideals-mt5-bridge.service
Wants=network-online.target
Requires=medideals-mt5-bridge.service
PartOf=medideals-bots.target

[Service]
Type=simple
User=medideals
Group=medideals
WorkingDirectory=/home/medideals/MediDeals-iOS-App/telegram_bot
EnvironmentFile=/etc/medideals/telegram.env
ExecStart=/usr/bin/python3 forex_scalper.py
Restart=on-failure
RestartSec=10
StartLimitInterval=300
StartLimitBurst=5
KillMode=process
SendSigKill=yes
SyslogIdentifier=medideals-forex-scalper
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/home/medideals/.cache /var/log/medideals /tmp
MemoryMax=512M
CPUQuota=25%

[Install]
WantedBy=medideals-bots.target
