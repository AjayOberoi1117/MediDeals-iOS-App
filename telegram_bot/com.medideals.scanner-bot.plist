<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.medideals.scanner-bot</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/python3</string>
        <string>-u</string>
        <string>/Users/ajayoberoi/MediDeals-iOS-App/telegram_bot/scanner_bot.py</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/ajayoberoi/MediDeals-iOS-App</string>
    <!-- Keep the process alive independently of candle/evaluation timing. -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/scanner-bot.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/scanner-bot.log</string>
</dict>
</plist>
