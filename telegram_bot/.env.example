# Telegram Bot Configuration
# Copy this file to .env and fill in actual values (DO NOT COMMIT .env)
# NOTE: @Equitytrading_bot is preserved as-is for existing stock signal workflow

# Primary notification channel
TELEGRAM_CHAT_ID=your_chat_id_here

# Bot tokens for signal routing
TELEGRAM_BOT_TOKEN=your_default_bot_token_here
GOLD_TELEGRAM_BOT_TOKEN=your_gold_bot_token_here
PAIRS_TELEGRAM_BOT_TOKEN=your_pairs_bot_token_here

# Trading platform credentials
UPSTOX_ACCESS_TOKEN=your_upstox_token_here
UPSTOX_API_KEY=your_upstox_api_key_here
