################################################################################
# DigitalOcean Deployment Configuration
# Location: /etc/medideals/telegram.env (owner: medideals:medideals, perms: 0600)
#
# IMPORTANT: Never commit this file to git. Load credentials from secure vault.
################################################################################

# ──────────────────────────────────────────────────────────────────────────────
# TELEGRAM BOT CREDENTIALS (Single routing via @Equitytrading_bot)
# ──────────────────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=<paste_token_from_secure_vault>
TELEGRAM_CHAT_ID=7093601171

# ──────────────────────────────────────────────────────────────────────────────
# BOT EXECUTION MODE (fail-closed: dry_run by default)
# ──────────────────────────────────────────────────────────────────────────────
# Allowed values: dry_run (signals only, no orders), production (signals + orders)
# Start in dry_run mode, switch to production only after all gates pass
BOT_EXECUTION_MODE=dry_run

# ──────────────────────────────────────────────────────────────────────────────
# MT5 BRIDGE CONFIGURATION (Wine headless + Vantage DEMO account)
# ──────────────────────────────────────────────────────────────────────────────
# These credentials are used by wine_server.py and local_trader.py
# MT5_LOGIN and MT5_SERVER are hardcoded in MT5 terminal after VNC login
# MT5_PASSWORD is stored in Wine registry after VNC login (never transmitted)
MT5_LOGIN=<vantage_demo_login_from_secure_vault>
MT5_PASSWORD=<vantage_demo_password_from_secure_vault>
MT5_SERVER=VantageMarkets-Demo

# ──────────────────────────────────────────────────────────────────────────────
# UPSTOX MARKET DATA CONFIGURATION (India equity signals, signal-only)
# ──────────────────────────────────────────────────────────────────────────────
UPSTOX_API_KEY=<paste_from_secure_vault>
UPSTOX_API_SECRET=<paste_from_secure_vault>

# ──────────────────────────────────────────────────────────────────────────────
# DEPLOYMENT METADATA (for health checks and logging)
# ──────────────────────────────────────────────────────────────────────────────
DEPLOYMENT_ENVIRONMENT=digitalocean
DEPLOYMENT_REGION=nyc3
VANTAGE_ACCOUNT_TYPE=DEMO
VANTAGE_ACCOUNT_VERIFIED=NO

# ──────────────────────────────────────────────────────────────────────────────
# GUARDS AND SAFETY CHECKS
# ──────────────────────────────────────────────────────────────────────────────
# LIVE_TRADING_CONFIRMED: required alongside BOT_EXECUTION_MODE=production
# Start with LIVE_TRADING_CONFIRMED=NO; set to YES only after verification gates
LIVE_TRADING_CONFIRMED=NO

# India order execution protection (fail-closed)
INDIA_ORDERS_ENABLED=NO

# ──────────────────────────────────────────────────────────────────────────────
# LOGGING & MONITORING
# ──────────────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=/var/log/medideals
LOG_RETENTION_DAYS=30
HEALTH_CHECK_INTERVAL_SECS=60
