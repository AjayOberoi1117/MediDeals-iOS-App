# ─────────────────────────────────────────────────────────────────────────────
# Windows MT5 Execution Bridge Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values locally on Windows
# DO NOT commit .env with real credentials
# ─────────────────────────────────────────────────────────────────────────────

# MetaTrader5 Credentials (Vantage DEMO account)
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# Telegram (for trade confirmations)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Execution Mode (SAFETY DEFAULT: signal_only)
# Allowed values: dry_run, signal_only, production
# DO NOT set to production without explicit authorization
BOT_EXECUTION_MODE=signal_only

# Live Trading Confirmation (ONLY required if BOT_EXECUTION_MODE=production)
# Must be set to YES for production trades (fails closed by default)
# LEAVE EMPTY for signal_only mode
LIVE_TRADING_CONFIRMED=

# Trade Queue Path (optional, defaults to .trade_queue.jsonl in script directory)
# TRADE_QUEUE_PATH=

# MT5 Signal File Path (optional, only if using file-bridge mode)
# MT5_FILES_PATH=
